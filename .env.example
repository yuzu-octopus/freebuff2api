# Freebuff API token(s)
#
# The router reads tokens from this env var (comma-separated for multi-token
# concurrency). Each token grants one independent session slot, so multiple
# tokens = parallel Freebuff sessions.
#
# Get your token from ~/.config/manicode/credentials.json after logging in via
# the Freebuff CLI, or from https://freebuff.com.
#
# Single token:
#   ROUTER_TOKEN=your_token_here
#
# Multiple tokens (for concurrency):
#   ROUTER_TOKEN=token_a,token_b,token_c
#
# If unset, the router falls back to reading the credentials file at
# ~/.config/manicode/credentials.json at startup.
ROUTER_TOKEN=your_token_here

# Optional: custom config file path (default: router.config.json)
# ROUTER_CONFIG=./router.config.json

# Optional: router auth key (defaults to ROUTER_TOKEN above).
# Agents send `Authorization: Bearer <ROUTER_KEY>` to call the router.
# ROUTER_KEY=your_router_key
