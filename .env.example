# Freebuff API token (from ~/.config/manicode/credentials.json)
# Used for:
#   1. Authenticating requests to the Freebuff API (server-side)
#   2. Default router auth key (agents send `Authorization: Bearer <ROUTER_TOKEN>`)
# Optional — if not set, the router reads it from ~/.config/manicode/credentials.json
ROUTER_TOKEN=your_token_here

# Optional: custom config file path (default: router.config.json)
# ROUTER_CONFIG=./router.config.json

# Optional: explicit router key (defaults to ROUTER_TOKEN above)
# Set this to a different value if you want a separate auth key for the router
# ROUTER_KEY=your_router_key